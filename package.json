{
  "name": "arias",
  "version": "1.0.0",
  "description": "Slack event routing service with OpenAI and extensible integrations",
  "private": true,
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "prisma generate && tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "@prisma/adapter-better-sqlite3": "7.10.0",
    "@prisma/client": "7.10.0",
    "@slack/bolt": "^5.1.0",
    "fastify": "^5.12.4",
    "google-auth-library": "^11.0.2",
    "openai": "^7.15.0",
    "prisma": "7.10.0",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@types/node": "^24.13.4",
    "dotenv": "^17.4.2",
    "googleapis": "^180.0.0",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3"
  },
  "allowScripts": {
    "better-sqlite3@12.11.1": true,
    "esbuild@0.28.2": true,
    "prisma@7.10.0": true,
    "@prisma/engines@7.10.0": true
  }
}
