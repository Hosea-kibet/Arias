NODE_ENV=development
HOST=127.0.0.1
PORT=3000
DATABASE_URL=file:./prisma/dev.db
# Generate a secret with: openssl rand -hex 32
API_KEY=replace-with-a-random-secret-at-least-24-characters
# Integrations are scaffolded only. These credentials are optional for startup.
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
SLACK_USER_TOKEN=
OPENAI_API_KEY=
# Set the model when implementing the agent; not required by the skeleton.
OPENAI_MODEL=
# Single Google account; enable Calendar and Sheets APIs and obtain an OAuth
# refresh token with calendar.events and spreadsheets scopes.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

GOOGLE_SERVICE_ACCOUNT_KEY_PATH=./prisma/google-service-account.json
GOOGLE_CALENDAR_ID=primary